# Base auth. A setup-token credential (`claude setup-token`, long-lived,
# survives the refresh-token bug on headless Linux) can make model requests
# but CANNOT start a Remote Control session. See DISABLE_REMOTE_CONTROL below.
CLAUDE_CODE_OAUTH_TOKEN=

PUID=1000
PGID=1000
TZ=UTC

ENABLE_FIREWALL=1
FIREWALL_REFRESH_SECONDS=3600
FIREWALL_ALLOW_DOMAINS=

# The single switch for Remote Control. Default "1" disables it (forces
# DISABLE_TELEMETRY, DO_NOT_TRACK, CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC
# and DISABLE_GROWTHBOOK to "1" — see entrypoint.sh and
# https://code.claude.com/docs/en/remote-control#requirements). Set to "0"
# to enable RC, and authenticate that container with `claude auth login`
# rather than a setup-token: only a full login session can be driven
# remotely, and API keys aren't supported for RC at all.
DISABLE_REMOTE_CONTROL=1

# Opt-in flags for bin/claude-run.sh. All unset/off by default.

# Set to "1" to skip writing the run's transcript into claude-home
# (--no-session-persistence). For one-off jobs nobody will --resume.
CLAUDE_NO_SESSION_PERSISTENCE=

# Set to "1" to drop Bash/code-exec tools and confine file tools to the
# working directory (--restricted). For jobs that only need Read/Grep/Write/Edit/MCP.
CLAUDE_RESTRICTED=

# Dollar amount, e.g. "2.00". Caps spend on a single headless run
# (--max-budget-usd). Useful since this image runs unattended/overnight.
CLAUDE_MAX_BUDGET_USD=

# Comma-separated model list, e.g. "claude-sonnet-5". Automatic fallback if
# the primary model is overloaded/unavailable (--fallback-model).
CLAUDE_FALLBACK_MODEL=

# Model for this run, e.g. "claude-haiku-4-5" (--model). Unset uses whatever
# the CLI defaults to.
CLAUDE_MODEL=

# Extra directory to grant read access to (--add-dir), on top of the working
# directory. File reads are always free within both, regardless of
# permission mode - use this to widen reads without widening what's editable.
CLAUDE_ADD_DIR=
