# Base auth. A setup-token credential (`claude setup-token`, long-lived,
# survives the refresh-token bug on headless Linux) can make model requests
# but CANNOT start a Remote Control session. See DISABLE_REMOTE_CONTROL below.
CLAUDE_CODE_OAUTH_TOKEN=

PUID=1000
PGID=1000
TZ=UTC

ENABLE_FIREWALL=1
FIREWALL_REFRESH_SECONDS=3600
FIREWALL_ALLOW_DOMAINS=

# The single switch for Remote Control. Default "1" disables it (and, with
# it, telemetry/autoupdate/error-reporting/nonessential-traffic — see
# entrypoint.sh). Set to "0" to enable RC, and authenticate that container
# with an interactive `claude` run (/login) rather than a setup-token: only
# a full /login session can be driven remotely.
DISABLE_REMOTE_CONTROL=1
